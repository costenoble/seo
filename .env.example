# Copier en .env (développement local) et saisir les mêmes variables dans Vercel → Settings → Environment Variables.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=            # clé secrète Supabase (suppression de compte) — ne jamais l'exposer au navigateur
# Pooler Supabase en mode transaction (port 6543) : Supabase → Connect → Transaction pooler
DATABASE_URL=postgresql://postgres.VOTRE-PROJET:MOT-DE-PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
TOKEN_ENCRYPTION_KEY=                 # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRON_SECRET=                          # python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=                     # identifiant OAuth Google (type Application Web), le même que dans Supabase
GOOGLE_CLIENT_SECRET=
# STEP_BUDGET=40                      # secondes de travail par appel (sous maxDuration de vercel.json)
# SUPABASE_JWT_SECRET=                # seulement si votre projet signe encore les sessions en HS256
